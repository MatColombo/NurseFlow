{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "@testing-library/jest-dom"],
    "paths": {
      "@app/*": ["./src/app/*"],
      "@domain/*": ["./src/domain/*"],
      "@storage/*": ["./src/storage/*"],
      "@features/*": ["./src/features/*"],
      "@shared/*": ["./src/shared/*"],
      "@test/*": ["./src/test/*"]
    }
  },
  "include": ["src"],
  "exclude": ["src/sw.ts"]
}
